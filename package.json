{
  "name": "maginary",
  "version": "0.1.0",
  "description": "Turn your AI plugins and skills into simple clickable apps. Runs on your own computer with your own AI subscription.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aryan-sk6/maginary.git"
  },
  "homepage": "https://github.com/Aryan-sk6/maginary#readme",
  "type": "module",
  "bin": {
    "maginary": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "examples"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
